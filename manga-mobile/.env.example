# Copier en .env.local (lu automatiquement par Expo, variables EXPO_PUBLIC_*
# inlinées au build — ne jamais y mettre de secret, seulement des clés
# publiques côté client).

# Même projet Supabase que le backend, mais la clé "anon" (publique,
# protégée par les policies RLS) — Settings > API dans le dashboard Supabase.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL du backend manga-tracker (recherche MangaDex/AniList).
# En local avec l'app sur un appareil physique/simulateur, utiliser
# l'IP locale de la machine plutôt que localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
