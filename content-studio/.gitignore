# Rushs et rendus : gros fichiers, jamais commités
rushs/
out/
*.mp4
*.mov
*.mkv

# (La boîte de réception des rushs de Cléa n'est plus ici : cin-philia est
# public, donc ce n'était pas adapté. Elle dépose désormais ses rushs dans
# le repo privé dédié busness3/rushs-a-monter.)

# Bibliothèque de sons fournie par Cléa : structure gardée (index.yaml),
# fichiers audio eux-mêmes non commités (trop lourds pour git).
sounds/music/*
sounds/sfx/*
!sounds/music/.gitkeep
!sounds/sfx/**/.gitkeep
!sounds/index.yaml

# Polices : Archivo (Google Fonts, licence SIL OFL) commitées — ce sont les
# polices imposées par la DA globale, pas des fichiers privés. Toute autre
# police que Cléa déposerait ici (hors DA actuelle) n'est pas commitée.
assets/fonts/*
!assets/fonts/.gitkeep
!assets/fonts/Archivo-Medium.ttf
!assets/fonts/ArchivoNarrow-SemiBold.ttf
!assets/fonts/OFL-Archivo.txt
!assets/fonts/OFL-ArchivoNarrow.txt

# Logo/watermark
assets/logo/*
!assets/logo/.gitkeep

__pycache__/
*.pyc
.pytest_cache/
