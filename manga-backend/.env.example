# Port d'écoute du serveur Express
PORT=3000

# Projet Supabase (Settings > API dans le dashboard Supabase)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé service_role — NE JAMAIS exposer côté mobile, backend uniquement.
# Nécessaire pour écrire dans manga_titles/notifications en contournant RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Intervalle du job de suivi des nouveaux chapitres, en syntaxe cron.
# Par défaut : toutes les heures, à la minute 0.
CHAPTER_CHECK_CRON="0 * * * *"

# User-Agent envoyé à l'API MangaDex (bonne pratique demandée par MangaDex,
# voir https://api.mangadex.org/docs/2-limitations/) — mets un identifiant
# de ton app + un contact.
MANGADEX_USER_AGENT="cin-philia-manga-tracker/1.0 (contact: ton-email@example.com)"

# Origine autorisée pour les requêtes CORS depuis l'app mobile en dev web
# (Expo web / tunnel). Laisse "*" en développement.
CORS_ORIGIN=*
